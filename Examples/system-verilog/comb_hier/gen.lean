import LeanModels.Sv.Ingest2
import LeanModels.Sv.CombHier

/-!
# `comb_hier`: a design with module instances in the `sv_comb` fragment

`halves.sv` instantiates one parameterized leaf twice, each copy over one half of the word, with the parameter overridden
by `W / 2`. Its family `halves.sem N` is the hierarchical instantiation (`PDesign.instantiateHDAlias2`, `Hier2.lean`). The
tactics read it through its flat twin (`CombHier.hierTwin`): the parent's processes, one continuous assignment per port
connection, each child's processes renamed under the instance prefix (`lo.`, `hi.`), and each child parameter a localparam
of the parent (`lo.W := W / 2`): nothing is unrolled, and the twin's widths stay symbolic. `CombHier.instantiateHDAlias2_twin`
proves `halves.sem N` equal to the twin's family wherever the twin's obligations hold; `comb_proof.lean` proves the design's
correctness at every even width through it.

* `halves.sv`: `y = a ^ b`, half by half;
* `wire_out.sv`: `y = ~a`, the halves of `halves.sv` with `wire` ports: the parent's output `y` is a net tiled by the
  instances' output ports. The extractor checks that each instance output targets `y`, that the windows cover it without
  overlap at the default point, and declares `y` a net-as-variable (`net_as_variable`); the loader reads it as an output
  port, so the twin's two continuous assignments `y[H-1:0] = lo.y`, `y[W-1:H] = hi.y` are the instantiation's, and the
  one-driver rule at every parameter point is the twin's disjointness obligation;
* `hier_param.sv`: `y = a`, the same tiling with the halves selected by `W/2` itself (no localparam): the bounds
  `W/2 - 1` and `W/2` are affine forms with a quotient atom (`CombView.Aff.qs`, `affDiv`);
* `sel_signed.sv`, `part_signed.sv`: a bit select and a part select of a signed input as the actual of a child's input
  port (the clean-room repros, verbatim): a select is an unsigned value (IEEE 1800-2023 §11.8.1), and the twin's
  connection is the actual's unsigned twin (`PExpr.unsign`), the select of the plain signal;
* `signed_mix.sv`: a whole signed input and a part select of it as actuals, and the parent's own continuous assign over the
  signed input: the twin carries the parent's processes and the actuals as their unsigned twins;
* `neg/`: the shapes the hierarchy summary refuses, with their reasons (`comb_errors.lean`).

The envelopes were generated by
`python3.12 extractors/sv/extract.py --top <module> Examples/system-verilog/comb_hier/<file>.sv -o <file>.sv.json`.
-/

namespace Examples.«system-verilog».comb_hier.gen

open LeanModels.Sv LeanModels.Sv.CombView LeanModels.Sv.CombHier

load_design_sv2 halves from "Examples/system-verilog/comb_hier/halves.sv.json"
load_design_sv2 wire_out from "Examples/system-verilog/comb_hier/wire_out.sv.json"
load_design_sv2 hier_param from "Examples/system-verilog/comb_hier/hier_param.sv.json"
load_design_sv2 sel_signed from "Examples/system-verilog/comb_hier/sel_signed.sv.json"
load_design_sv2 part_signed from "Examples/system-verilog/comb_hier/part_signed.sv.json"
load_design_sv2 signed_mix from "Examples/system-verilog/comb_hier/signed_mix.sv.json"

-- The design instantiates modules: the flat recognizer refuses it, and its flat twin is summarized.
#guard halves.pdesign.summary.toOption.isNone
#guard (summaryH halves.pdesign halves.plib).toOption.isSome

-- The hierarchy summary's constants: the parent's parameter and localparam, then each child's parameter, overridden by
-- `W / 2`; its sites: per instance, the three port connections, then the leaf's assignment.
#guard ((summaryH halves.pdesign halves.plib).toOption.map (·.params)) == some ["W", "H", "lo.W", "hi.W"]
#guard ((summaryH halves.pdesign halves.plib).toOption.map fun s => s.statics.map (·.tgt.name)) ==
  some ["lo.a", "lo.b", "y", "lo.y", "hi.a", "hi.b", "y", "hi.y"]

-- The twin's declarations and processes are the hierarchical instantiation's, in its order (at `W = 8`).
#guard (halves.sem 8).decls.toList.map (·.name) == ["a", "b", "y", "lo.a", "lo.b", "lo.y", "hi.a", "hi.b", "hi.y"]

-- A run at `W = 8`: `a = 0x5A`, `b = 0x0F`: `y = 0x55`.
#guard (match run2 (halves.sem 8) σ_src 1000 [[("a", .ofNat 8 0x5A), ("b", .ofNat 8 0x0F)]] with
  | .ok [st] => (SvState.lookup st "y").map LVec.toBinString == some "01010101"
  | _ => false)

-- `wire` ports: `y` is an output port (a net-as-variable), driven by the two output connections.
#guard (summaryH wire_out.pdesign wire_out.plib).toOption.isSome
#guard ((summaryH wire_out.pdesign wire_out.plib).toOption.map fun s => s.statics.map (·.tgt.name)) ==
  some ["lo.a", "y", "lo.y", "hi.a", "y", "hi.y"]
#guard (match run2 (wire_out.sem 8) σ_src 1000 [[("a", .ofNat 8 0x5A)]] with
  | .ok [st] => (SvState.lookup st "y").map LVec.toBinString == some "10100101"
  | _ => false)

-- `W/2` in the bounds: the quotient atom `W/2` (`Aff.qs`) in the connections' windows.
#guard (summaryH hier_param.pdesign hier_param.plib).toOption.isSome
#guard ((summaryH hier_param.pdesign hier_param.plib).toOption.map (·.params)) == some ["W", "lo.W", "hi.W"]
#guard ((summaryH hier_param.pdesign hier_param.plib).toOption.map fun s =>
    (s.statics.map (·.tgt)).filter (·.name == "y")) ==
  some [.part1 "y" { c := -1, qs := [("W", 1, 2)] } (Aff.const 0),
    .part1 "y" { terms := [("W", 1)], c := -1 } { qs := [("W", 1, 2)] }]
#guard (match run2 (hier_param.sem 8) σ_src 1000 [[("a", .ofNat 8 0x5A)]] with
  | .ok [st] => (SvState.lookup st "y").map LVec.toBinString == some "01011010"
  | _ => false)

-- Signed reads through ports: the twin's connections read the plain signal (the actual's unsigned twin), and the
-- hierarchical instantiation reads the signed one; `run2` of `X.sem` gives the select's bits (local Icarus 12.0 agrees
-- on all 256 values of `x`, and gives `x = 8'b1010`'s sign extension `11111010` for the wider port of
-- `neg/signed_port_wide.sv`, which stays refused).
#guard ((summaryH sel_signed.pdesign sel_signed.plib).toOption.map fun s => s.statics.map (·.proc)) ==
  some [.assign "leaf.a" (.bitSel (.ident "x") (.int 0)), .assignL (.ident "y") (.ident "leaf.y"),
    .assign "leaf.y" (.ident "leaf.a")]
#guard (match run2 sel_signed.sem σ_src 1000 [[("x", .ofNat 8 0x81)], [("x", .ofNat 8 0x7E)]] with
  | .ok [s1, s2] => (SvState.lookup s1 "y").map LVec.toBinString == some "1" &&
      (SvState.lookup s2 "y").map LVec.toBinString == some "0"
  | _ => false)
#guard (match run2 part_signed.sem σ_src 1000 [[("x", .ofNat 8 0x81)], [("x", .ofNat 8 0x7E)]] with
  | .ok [s1, s2] => (SvState.lookup s1 "y").map LVec.toBinString == some "1" &&
      (SvState.lookup s2 "y").map LVec.toBinString == some "0"
  | _ => false)
#guard ((summaryH signed_mix.pdesign signed_mix.plib).toOption.map fun s => s.statics.map (·.tgt.name)) ==
  some ["z", "leaf.a", "leaf.b", "y", "leaf.y"]
#guard (match run2 signed_mix.sem σ_src 1000 [[("x", .ofNat 8 0xA5), ("w", .ofNat 8 0x0F)]] with
  | .ok [st] => (SvState.lookup st "y").map LVec.toBinString == some "00001111" &&
      (SvState.lookup st "z").map LVec.toBinString == some "00000101"
  | _ => false)

end Examples.«system-verilog».comb_hier.gen
