import LeanModels.Sv.Ingest2

/-!
# `comb_lin`: a chain of nine plain sites at symbolic widths, the regression test of the grouped route (WP-LIN)

`lin_chain.sv` is a parametric design (`W`, `P`) of nine `assign`s, two windows per vector for `x0` to `x3`, each window
reading the previous vector: not a flat netlist (it has parameters), and not below `groupMinSites`, so `sv_structure` and
`sv_equations` restrict the one-driver, rank and cover obligations to the sites that write the same signal
(`CombViewGroup.lean`, `CombEqGroup.lean`). Its envelope was generated by

    python3.12 extractors/sv/extract.py --top lin_chain Examples/system-verilog/comb_lin/lin_chain.sv \
      -o Examples/system-verilog/comb_lin/lin_chain.sv.json

`chain.lean` is the test over it. The envelope is read at elaboration time: force a rebuild of this module after
re-extracting it.
-/

namespace Examples.«system-verilog».comb_lin.gen

open LeanModels.Sv

load_design_sv2 lin_chain from "Examples/system-verilog/comb_lin/lin_chain.sv.json"

end Examples.«system-verilog».comb_lin.gen
