import LeanModels.Sv.Ingest2
import LeanModels.Sv.CombProcTactic

/-!
# Unpacked storage the tactics do not read, and whose wall it is

The tactics are sound against the semantic-tier family `X.sem` (`Design2`, `run2`). Unpacked storage reaches it only in
part: a FIXED-size array (every unpacked bound a literal) is one declaration per cell, `stage[0]`, `stage[1]`, …, and a
cell select at a literal index reads its cell (`fixed_cells.sv`, proved in `comb_proof.lean`). The other shapes are
refused, each naming the layer that holds them:

* `neg/unpacked_generate_array.sv` (the clean-room repro, verbatim below its header): a PARAMETER-SIZED unpacked array
  `logic [W-1:0] stage [0:S-1]` written and read at constant indices. `X.sem` has no model of the declaration: its
  instantiation refuses it (`instDecl`: unpacked array storage outside E), so the whole family is one loud process. The
  cells live only on the source-shaped memory route (`instantiateMemD2`, `runMem2`), which is executable and has no proof
  layer the tactics could be sound against. Reading it needs a `Design2` lowering of parameter-sized unpacked storage
  first.
* `neg/cell_genvar.sv`: a FIXED-size array `logic [W-1:0] stage [0:3]` whose cells are written at a GENVAR index,
  `stage[i+1] = ~stage[i]` in a generate loop. The extractor refuses the select (`ElementSelect:default-point-index`):
  the array is one declaration per cell, and an index that changes with the iteration has no per-cell form short of
  unrolling. The next wall is ls-sv's, and it is the same lowering the parameter-sized array needs: the array in `X.sem`
  as ONE declaration, its cells laid out as a 2-D packed array, the genvar and parameter indices lowered as constant
  slices; the tactics would then read the cells as the 2-D packed accesses they read today.
* `neg/readmemh_lit.sv`: a fixed ROM `logic [7:0] rom [0:3]` loaded at time zero by `$readmemh("rom.hex", rom)` (the
  literal file beside it). `X.sem` has the ROM's cells, as uninitialized declarations `rom[0]` … `rom[3]`, and keeps the
  `initial` as the loud process `T2:Initial`; only the memory route's initial phase loads the file. So the cells hold no
  constants in the family the tactics are sound against, and the `initial` is refused, naming that.
* `neg/readmemh_child.sv`: the same ROM inside a child module; the refusal names the child's ROM load. (A ROM loaded
  inside a generate block does not reach the tactics: the loader refuses an `initial` there, "unknown generate member
  kind".)
* `neg/readmemh_rom.sv` (the clean-room repro, verbatim below its header): the ROM's file is a string parameter `FILE`.
  The extractor refuses the task below the tactics: it reads the argument's source text `FILE` as a literal file name and
  finds no such file (`SystemTask:readmemh:missing-file`); were a file named `FILE` beside the source, it would load that
  one (ls-sv's, reported). No ROM reaches a theorem either way: the tactics refuse every `$readmemh` design.

The envelopes were generated by
`python3.12 extractors/sv/extract.py --top <module> Examples/system-verilog/comb_mem/<path>.sv -o <path>.sv.json`.
-/

open LeanModels.Sv LeanModels.Sv.CombView

namespace Examples.«system-verilog».comb_mem.comb_errors

load_design_sv2 unpacked_generate_array from "Examples/system-verilog/comb_mem/neg/unpacked_generate_array.sv.json"
load_design_sv2 readmemh_lit from "Examples/system-verilog/comb_mem/neg/readmemh_lit.sv.json"
load_design_sv2 readmemh_rom from "Examples/system-verilog/comb_mem/neg/readmemh_rom.sv.json"
load_design_sv2 cell_genvar from "Examples/system-verilog/comb_mem/neg/cell_genvar.sv.json"
load_design_sv2 readmemh_child from "Examples/system-verilog/comb_mem/neg/readmemh_child.sv.json"

/-! These are explicit scalar-route negative controls.  The ordinary `.sem`
families for designs with unpacked declarations now return canonical E
`CoreMemDesign`; the comb tactics intentionally continue to check the
scalar-only `EDesign2` family, so keep that refusal surface explicit here. -/
def unpacked_generate_array_scalar (W S : Nat) : Design2 :=
  PDesign.instantiateGDAlias2 unpacked_generate_array.pdesign [W, S]
def readmemh_lit_scalar : Design2 :=
  PDesign.instantiateGDAlias2 readmemh_lit.pdesign []
def readmemh_rom_scalar (n : Nat) : Design2 :=
  PDesign.instantiateGDAlias2 readmemh_rom.pdesign [n]
def cell_genvar_scalar (W : Nat) : Design2 :=
  PDesign.instantiateGDAlias2 cell_genvar.pdesign [W]
def readmemh_child_scalar : Design2 :=
  PDesign.instantiateGDAlias2 readmemh_child.pdesign []

-- `X.sem` is one loud process at every parameter point (here `W = 8`, `S = 2`): the declaration is refused.
#guard (unpacked_generate_array_scalar 8 2).decls.size == 0
#guard (match (unpacked_generate_array_scalar 8 2).processes.toList with
  | [.unsupported k t] => k == "Instantiate" &&
      t == "decl 'stage': unpacked array storage outside E (UnpackedDecl:memory)"
  | _ => false)

/--
error: sv_structure: outside the supported fragment — declaration `stage`: unpacked array storage whose shape depends on a parameter (UnpackedDecl:memory), which the semantic-tier family `X.sem` does not model: its instantiation refuses the declaration (`instDecl`: unpacked array storage outside E), so the whole family is one loud process; the cells live only on the source-shaped memory route (`instantiateMemD2`, `runMem2`), which has no proof layer the tactics could be sound against (a FIXED-size unpacked array reaches `X.sem` as one declaration per cell, `stage[0]`, …, which the tactics read)
-/
#guard_msgs (whitespace := lax) in
example (W S : Nat) (hW : 1 ≤ W) (hS : 2 ≤ S) (hR : (W : Int) < 2147483648) (hR' : (S : Int) < 2147483648) :
    CombDesign (unpacked_generate_array_scalar W S) := by
  sv_structure

-- The literal ROM: `X.sem` has the cells, uninitialized, and the `initial` as a loud process.
#guard (readmemh_lit_scalar.decls.toList.map fun d => (d.name, d.init.isSome)) ==
  [("addr", false), ("q", false), ("rom[0]", false), ("rom[1]", false), ("rom[2]", false), ("rom[3]", false)]
#guard (match readmemh_lit_scalar.processes.toList with
  | .unsupported k _ :: _ => k == "T2:Initial"
  | _ => false)

/--
error: sv_structure: outside the supported fragment — site `plain#0`: procedural process (`initial`): outside the combinational-assign fragment (the `initial` is a `$readmemh` ROM load, which the semantic-tier family `X.sem` keeps as the loud process `T2:Initial`, the ROM's cells uninitialized declarations; the file contents are loaded only on the source-shaped memory route, `runMem2`, which has no proof layer the tactics could be sound against)
-/
#guard_msgs (whitespace := lax) in
example : CombDesign readmemh_lit_scalar := by
  sv_structure

/--
error: sv_structure: outside the supported fragment — site `plain#0`: procedural process (`initial`): outside the combinational-assign fragment (the `initial` is a `$readmemh` the extractor refuses, below the tactics: `SystemTask:readmemh:missing-file`: literal file 'FILE' is not present beside the source)
-/
#guard_msgs (whitespace := lax) in
example (n : Nat) : CombDesign (readmemh_rom_scalar n) := by
  sv_structure

-- A fixed array at a genvar index: the extractor's refusal, named.
#guard (match (cell_genvar_scalar 8).processes.toList with
  | Process2.assign _ _ :: Process2.assign _ _ ::
      Process2.unsupported k t :: _ =>
      k == "ElementSelect:default-point-index" && t == "stage[i+1] = ~stage[i]"
  | _ => false)

-- The literal ROM inside a child module: the scalar route names hierarchy as
-- an unsupported module instance; the canonical E hierarchy route is separate.
#guard (match readmemh_child_scalar.processes.toList with
  | [Process2.unsupported k t] =>
      k == "Instance" && t ==
        "module instance 'u' of 'rom4': flat instantiation (hierarchical designs instantiate through `PDesign.instantiateH`, Hier2.lean)"
  | _ => false)

end Examples.«system-verilog».comb_mem.comb_errors
