import LeanModels.Sv.Ingest2
import LeanModels.Sv.Comb2
import LeanModels.Sv.CombEqTactic
import LeanModels.Sv.CombProcTactic

/-!
# A fixed-size unpacked array, for every width, by `sv_structure` + `sv_equations`

`fixed_cells.sv` is the clean-room repro `unpacked_generate_array.sv` with its cell count a literal: `logic [W-1:0]
stage [0:1]`, written and read at literal indices. The semantic-tier family `X.sem` declares one signal per cell
(`stage[0]`, `stage[1]`: the extractor's fixed-array cells, the declaration's packed type kept, so the cells are `W` bits
wide at every `W`), and a cell select at a literal index reads its cell, so the summary reads three continuous assignments
over plain signals: no unpacked storage reaches the tactics, and nothing is unrolled. (A parameter-sized array, or a cell
index naming a genvar or a parameter, is refused: `comb_errors.lean`.)

* `fixed_cells_correct`: in every settled state, `y = x`, at every width `W ≥ 1` in the `int` range.

The envelope was generated by
`python3.12 extractors/sv/extract.py --top fixed_cells Examples/system-verilog/comb_mem/fixed_cells.sv -o fixed_cells.sv.json`.
-/

open LeanModels.Sv LeanModels.Sv.CombView LeanModels.Sv.CombEq

namespace Examples.«system-verilog».comb_mem.comb_proof

load_design_sv2 fixed_cells from "Examples/system-verilog/comb_mem/fixed_cells.sv.json"

-- `X.sem` has one declaration per cell, and the three assignments.
#guard ((fixed_cells.sem 8).decls.toList.map (·.name)) == ["x", "y", "stage[0]", "stage[1]"]
#guard (fixed_cells.sem 8).processes.size == 3
#guard (match run2 (fixed_cells.sem 8) σ_src 1000 [[("x", .ofNat 8 0x5A)]] with
  | .ok [st] => (SvState.lookup st "y").map LVec.toBinString == some "01011010"
  | _ => false)

/-- A known signal of width `W` holds the bit vector of its Boolean bits. -/
theorem lookup_bv {st : SvState} {n : String} {W : Nat}
    (hk : ∀ k, k < W → (∃ v, SvState.lookup st n = some v ∧ v.width = W) ∧ KnownBit st n k) (hW : 0 < W) :
    SvState.lookup st n = some (LVec.ofBitVec (XF.bv W (st.boolAt n))) := by
  obtain ⟨⟨v, hv, hvw⟩, -⟩ := hk 0 hW
  have := SvState.lookup_eq_ofBitVec_bv hv hvw (fun k hk' => (hk k hk').2)
  rw [hv, this]

/-- **The fixed two-cell array passes the word through**, at every width `W ≥ 1` in the `int` range: `stage[0] = x`,
`stage[1] = stage[0]`, `y = stage[1]`. -/
theorem fixed_cells_correct (W : Nat) (hW : 1 ≤ W) (hR : (W : Int) < 2147483648) :
    fixed_cells.sem W ⊨₂ spec2 fun _ tr => ∀ (c : Nat) (st : SvState), tr[c]? = some st →
      ∀ (u : BitVec W), SvState.lookup st "x" = some (LVec.ofBitVec u) →
        SvState.lookup st "y" = some (LVec.ofBitVec u) := by
  obtain ⟨hc, ha⟩ : CombDesign (fixed_cells.sem W) ∧ Acyclic (fixed_cells.sem W) := by
    sv_structure (rank := rippleRank (fun p => p) (fun _ _ _ => 0))
    all_goals (intros; omega)
  refine Models2.of_comb_pointwise hc (fun st heqs hsh => ?_)
  intro u hA
  sv_equations
  · have hWd : (↑W + -1 : Int).natAbs + 1 = W := by omega
    rw [hWd] at eq_y_1 known_y_1 «eq_stage[1]_1» «eq_stage[0]_1»
    rw [lookup_bv known_y_1 (by omega)]
    congr 2
    apply BitVec.eq_of_getLsbD_eq
    intro i hi
    rw [XF.getLsbD_bv hi, eq_y_1 i hi, «eq_stage[1]_1» i hi, «eq_stage[0]_1» i hi, SvState.boolAt_ofBitVec hA hi]
  all_goals first
    | (intros; omega)
    | (refine inKnown_ofBitVec hA ?_; omega)

/-- info: 'Examples.«system-verilog».comb_mem.comb_proof.fixed_cells_correct' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs (whitespace := lax) in
#print axioms fixed_cells_correct

end Examples.«system-verilog».comb_mem.comb_proof
