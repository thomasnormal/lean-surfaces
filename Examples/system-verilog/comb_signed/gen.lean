import LeanModels.Sv.Ingest2
import LeanModels.Sv.CombSigned

/-!
# `comb_signed`: signed declarations and signed reads in the `sv_comb` fragment

The loader reads a signed signal as the cast marker around the identifier (`PExpr.cast true (.ident n)`), and keeps the
signedness of each declaration (`Decl.isSigned`). The tactics summarize the UNSIGNED TWIN of such a design
(`PDesign.unsign`: every signed read in an operand of a continuous assign replaced by the unsigned read of the same
signal) and carry each theorem back to the design as written along `instantiateGD2_unsign_view` (`CombSigned.lean`),
under the width obligation of `sv_equations` (no operand is implicitly widened, so no signed operand is ever extended).

* `sadd.sv`: two's-complement `+` and `-` on signed operands of one width, a bitwise mix, and a signed input copied to an
  unsigned output (`comb_proof.lean` proves all four for every width);
* `pass.sv`: a signed input copied to an unsigned output of the same width;
* `neg/`: the constructs whose meaning signedness changes, refused with that reason (`comb_errors.lean`): a signed
  comparison, an arithmetic shift right, a select of a signed signal. (Sign extension into a wider target, `neg/sg_ext.sv`,
  never reaches the tactics: at a symbolic width the extractor marks the conversion `ConversionExpression:width`.)

The envelopes were generated by
`python3.12 extractors/sv/extract.py --top <module> Examples/system-verilog/comb_signed/<file>.sv -o <file>.sv.json`.
-/

namespace Examples.«system-verilog».comb_signed.gen

open LeanModels.Sv LeanModels.Sv.CombView

load_design_sv2 sadd from "Examples/system-verilog/comb_signed/sadd.sv.json"
load_design_sv2 pass from "Examples/system-verilog/comb_signed/pass.sv.json"

-- The design as written has signed reads: the recognizer refuses them, and summarizes the unsigned twin.
#guard sadd.pdesign.summary.toOption.isNone
#guard sadd.pdesign.unsign.summary.toOption.isSome
#guard (sadd.pdesign.unsign == sadd.pdesign) == false
#guard pass.pdesign.summary.toOption.isNone
#guard pass.pdesign.unsign.summary.toOption.isSome

-- The declarations keep their signedness (the summary's too).
#guard (sadd.sem 8).decls.toList.map (·.isSigned) == [true, true, true, true, false, false]
#guard (sadd.pdesign.unsign.summary.toOption.map fun s => s.decls.map (·.isSigned)) ==
  some [true, true, true, true, false, false]

-- A run at `W = 4`: `a = -3` (1101), `b = 5` (0101): `s = 2` (0010), `d = -8` (1000), `x = 1101 ^ ~0101 = 0111`,
-- `y = 1101`.
#guard (match run2 (sadd.sem 4) σ_src 1000 [[("a", .ofNat 4 13), ("b", .ofNat 4 5)]] with
  | .ok [st] =>
      (SvState.lookup st "s").map LVec.toBinString == some "0010" &&
      (SvState.lookup st "d").map LVec.toBinString == some "1000" &&
      (SvState.lookup st "x").map LVec.toBinString == some "0111" &&
      (SvState.lookup st "y").map LVec.toBinString == some "1101"
  | _ => false)

end Examples.«system-verilog».comb_signed.gen
