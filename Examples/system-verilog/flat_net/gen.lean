import LeanModels.Sv.Ingest2
import LeanModels.Sv.Gen2
import LeanModels.Sv.Hier2Gen

/-!
# `flat_net`: a flat gate-level netlist, as an `sv_structure` test subject (WP-P3b)

`flat_net.sv` is a 4-bit ripple-carry adder written out gate by gate: ten continuous assigns, no
parameter, no generate loop (every site plain). Its envelope `flat_net.sv.json` was generated by

    python3.12 extractors/sv/extract.py --top flat_net Examples/system-verilog/flat_net/flat_net.sv \
      -o Examples/system-verilog/flat_net/flat_net.sv.json

This module only loads the design (`flat_net.pdesign`, `flat_net.sem`); `comb_view.lean` is the
acceptance test over it. Like the other SV examples, the envelope is read at elaboration time: force a
rebuild of this module after re-extracting it.
-/

namespace Examples.«system-verilog».flat_net.gen

open LeanModels.Sv

load_design_sv2 flat_net from "Examples/system-verilog/flat_net/flat_net.sv.json"

end Examples.«system-verilog».flat_net.gen
