import LeanModels.Sv.Ingest2
import LeanModels.Sv.Gen2
import LeanModels.Sv.CombView

/-!
# `gen_deep`: generate loops nested three deep, as `sv_comb` test subjects

A generate block may hold further generate constructs (IEEE 1800-2023 §27.4), to any depth. The summary's generate tree
is recursive (`TItem.loop` over items), a site is located by the headers of all the loops around it (`LSite.hdrs`,
outermost first), and its identity carries one index per loop (`SiteId.fam label pos [i, j, k]`).

* `gen_deep.sv`: a family three deep with sites at every depth, and a family whose innermost bounds name both enclosing
  genvars;
* `neg/gen_deep_dup.sv`: two blocks with one label at one depth (identities would collide), refused by the structural
  check.

The envelopes were generated by
`python3.12 extractors/sv/extract.py --top <module> Examples/system-verilog/gen_deep/<file>.sv -o <file>.sv.json`.
-/

namespace Examples.«system-verilog».gen_deep.gen

open LeanModels.Sv LeanModels.Sv.CombView

load_design_sv2 gen_deep from "Examples/system-verilog/gen_deep/gen_deep.sv.json"
load_design_sv2 gen_deep_dup from "Examples/system-verilog/gen_deep/neg/gen_deep_dup.sv.json"

-- The located sites: their blocks, positions and loops (outermost first).
#guard (gen_deep.pdesign.summary.toOption.map fun s => s.lsites.map fun ls => (ls.blk, ls.site.pos, ls.hdrs.map (·.g))) ==
  some [("g_k", 0, ["i", "j", "k"]), ("g_col", 1, ["i", "j"]), ("g_row", 1, ["i"]),
        ("h_k", 0, ["i", "j", "k"]), ("h_z", 0, ["i", "j", "k"])]

-- The instantiation at `N = 3` builds 27 + 9 + 3 cells and reads of the first family, and 2 * 3 * 5 = 30 cells of `e`:
-- the closed-form list of the summary has the same length.
#guard ((gen_deep.pdesign.instantiate2 [3] (PDesign.surfaceFuel [3])).toOption.map fun m => m.processes.size) == some 69
#guard (gen_deep.pdesign.summary.toOption.map fun s => (s.insts (s.val [3])).length) == some 69

end Examples.«system-verilog».gen_deep.gen
