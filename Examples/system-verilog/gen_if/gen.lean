import LeanModels.Sv.Ingest2
import LeanModels.Sv.Gen2
import LeanModels.Sv.CombView

/-!
# `gen_if`: conditional generate constructs inside generate loops, as `sv_comb` test subjects

A conditional generate construct (IEEE 1800-2023 §27.5) inside a loop instantiates the arm its condition selects at each
iteration. The summary reads the condition as a guard (`guardOf?`: `s< s<= s> s>=`, `==`, `!=` of two affine forms in
the parameters and the enclosing genvars), keeps both arms (`TItem.cond`), and puts each arm's sites under the guard
(`Hdr.gs` of the enclosing loop's header in the site's loops), so every obligation about a site is owed where its arm
is the one instantiated. The arms have no block of their own in the envelope: their sites are numbered in the enclosing
loop's block (`GenItem.slots`), the `then` arm first.

* `gen_if.sv`: an arm chosen by `i >= 1`, a two-level loop whose arm compares the two genvars (`i >= l + 1`), and an
  `else if` chain with `==` and `!=`;
* `neg/gen_if_bit.sv`: a condition `(i & 1) == 0`, outside the guard fragment, refused;
* `neg/gen_if_wide.sv`: a condition `i + N * 1024 > 0`, read; its operands' values are owed in the 32-bit range, which
  needs a bound on `N` tighter than the `int` range.

The envelopes were generated by
`python3.12 extractors/sv/extract.py --top <module> Examples/system-verilog/gen_if/<file>.sv -o <file>.sv.json`.
-/

namespace Examples.«system-verilog».gen_if.gen

open LeanModels.Sv LeanModels.Sv.CombView

load_design_sv2 gen_if from "Examples/system-verilog/gen_if/gen_if.sv.json"
load_design_sv2 gen_if_bit from "Examples/system-verilog/gen_if/neg/gen_if_bit.sv.json"
load_design_sv2 gen_if_wide from "Examples/system-verilog/gen_if/neg/gen_if_wide.sv.json"

-- The located sites: blocks, positions (the arms numbered in the loop's block) and the guards of their arms.
#guard (gen_if.pdesign.summary.toOption.map fun s => s.lsites.map fun ls =>
    (ls.blk, ls.site.pos, ls.hdrs.map fun h => (h.g, h.gs.map (·.2)))) ==
  some [("g_bit", 0, [("i", [true])]), ("g_bit", 1, [("i", [false])]), ("g_in", 0, [("i", [])]),
        ("g_node", 0, [("l", []), ("i", [true])]), ("g_node", 1, [("l", []), ("i", [false])]),
        ("g_out", 0, [("i", [true])]), ("g_out", 1, [("i", [false, true])]), ("g_out", 2, [("i", [false, false])])]

-- The instantiation at `N = 5` builds 5 + 5 + 3 * 5 + 5 processes, one per iteration and arm: the closed-form list of
-- the summary has the same length.
#guard ((gen_if.pdesign.instantiate2 [5] (PDesign.surfaceFuel [5])).toOption.map fun m => m.processes.size) == some 30
#guard (gen_if.pdesign.summary.toOption.map fun s => (s.insts (s.val [5])).length) == some 30

-- The arm the instantiation selects (`evalGenGuard` of each condition, at the environment of `N = 5` with the genvars
-- bound) and the summary's guard (`Guard.holds` at the summary's valuation) agree with the values Icarus Verilog 13.0
-- prints for the same conditions over the same 32-bit `int` operands (`iverilog -g2012`, a testbench of the four
-- conditions at each `l`, `i`): `i >= 1`, `i == 0`, `i != N - 1` for `i = 0 … 4`, and `i >= l + 1` for `l = 0 … 2`.
#guard (gen_if.pdesign.summary.toOption.bind fun s => (gen_if.pdesign.paramEnv2 [5]).toOption.bind fun e =>
    match s.condSteps with
    | [(_, c0, _), (_, c1, _), (_, c2, _), (_, c3, _)] =>
        some (([0, 1, 2, 3, 4] : List Int).map (fun i => [c0, c2, c3].map fun c => (evalGenGuard (e.bindVal "i" i) c).toOption),
          ([0, 1, 2] : List Int).map fun l => ([0, 1, 2, 3, 4] : List Int).map fun i =>
            (evalGenGuard ((e.bindVal "l" l).bindVal "i" i) c1).toOption)
    | _ => none) ==
  some ([[some 0, some 1, some 1], [some 1, some 0, some 1], [some 1, some 0, some 1], [some 1, some 0, some 1],
      [some 1, some 0, some 0]],
    [[some 0, some 1, some 1, some 1, some 1], [some 0, some 0, some 1, some 1, some 1],
      [some 0, some 0, some 0, some 1, some 1]])
#guard (gen_if.pdesign.summary.toOption.bind fun s =>
    match s.condSteps with
    | [(_, _, g0), (_, _, g1), (_, _, g2), (_, _, g3)] =>
        some (([0, 1, 2, 3, 4] : List Int).map (fun i => [g0, g2, g3].map fun g =>
            decide (g.holds (bindσ "i" i (s.val [5])))),
          ([0, 1, 2] : List Int).map fun l => ([0, 1, 2, 3, 4] : List Int).map fun i =>
            decide (g1.holds (bindσ "i" i (bindσ "l" l (s.val [5])))))
    | _ => none) ==
  some ([[false, true, true], [true, false, true], [true, false, true], [true, false, true], [true, false, false]],
    [[false, true, true, true, true], [false, false, true, true, true], [false, false, false, true, true]])

-- Beyond the 32-bit range the instantiation follows the `int` arithmetic of the genvar and the `int` localparam (IEEE
-- 1800-2023 §27.4, §11.4): `i + N * 1024 > 0` at `N = 2097151`, `i = 2046` is `0` (the sum wraps to a negative value),
-- where the summary's guard, read over the integers, holds; this is why the guard's operands are owed in the 32-bit
-- range (`AutoObl`). Icarus Verilog 13.0 selects the `then` arm there (it evaluates a generate condition over genvars
-- without the 32-bit wrap); at `i = 1023`, in range, all three agree. No oracle agreement is claimed outside the
-- range, and the tactics claim nothing there: the range obligation fails.
#guard (gen_if_wide.pdesign.summary.toOption.bind fun s => (gen_if_wide.pdesign.paramEnv2 [2097151]).toOption.bind
    fun e => match s.condSteps with
      | [(_, c, g)] => some (([1023, 2046] : List Int).map fun i => ((evalGenGuard (e.bindVal "i" i) c).toOption,
          decide (g.holds (bindσ "i" i (s.val [2097151])))))
      | _ => none) == some [(some 1, true), (some 0, true)]

end Examples.«system-verilog».gen_if.gen
