import LeanModels.Sv.Ingest2
import LeanModels.Sv.Gen2
import LeanModels.Sv.CombView

/-!
# `gen_tri`: generate bounds that name an enclosing genvar, as `sv_comb` test subjects

A loop generate scheme's bound is a constant expression, and inside the block of a loop its genvar is a constant
(IEEE 1800-2023 §27.4), so an inner loop's bound may name it: `for (j = 0; j < i + 1; j++)` in a loop over `i`. The
summary reads such a bound as an affine form in the parameters AND the enclosing genvars (`Summary.StructOk`), evaluates
it at each valuation of the loops around it (`Hdr.Rng` under `Loops.all`), and owes the generate fuel there
(`Summary.hdrSteps`, `AutoObl`).

* `gen_tri.sv`: two triangular loops per row, `j < i + 1` and `j < N - 1 - i`;
* `neg/gen_sq_bound.sv`: a bound `j < i * i + 1` (a product of genvars): not affine, refused.

The envelopes were generated by
`python3.12 extractors/sv/extract.py --top <module> Examples/system-verilog/gen_tri/<file>.sv -o <file>.sv.json`.
-/

namespace Examples.«system-verilog».gen_tri.gen

open LeanModels.Sv LeanModels.Sv.CombView

load_design_sv2 gen_tri from "Examples/system-verilog/gen_tri/gen_tri.sv.json"
load_design_sv2 gen_sq_bound from "Examples/system-verilog/gen_tri/neg/gen_sq_bound.sv.json"

-- The summary: one top-level loop whose body holds two inner loops (bounds `i + 1` and `N - 1 - i`) and a site.
#guard (gen_tri.pdesign.summary.toOption.map fun s => s.hdrSteps.map fun q => (q.1.map (·.g), q.2.g, q.2.bound.names)) ==
  some [([], "i", ["N"]), (["i"], "j", ["i"]), (["i"], "j", ["N", "i"])]

-- The instantiation at `N = 4` builds 4 + 6 cells below and on the diagonal, 6 above it, and 4 diagonal reads: the
-- closed-form list of the summary has the same length.
#guard ((gen_tri.pdesign.instantiate2 [4] (PDesign.surfaceFuel [4])).toOption.map fun m => m.processes.size) == some 20
#guard (gen_tri.pdesign.summary.toOption.map fun s => (s.insts (s.val [4])).length) == some 20

end Examples.«system-verilog».gen_tri.gen
