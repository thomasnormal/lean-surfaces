import LeanModels.Sv.Ingest2
import LeanModels.Sv.Gen2
import LeanModels.Sv.CombView

/-!
# `lp_cond`: localparams defined by comparisons and `?:`, as `sv_comb` test subjects

A localparam of the fragment may use `c ? a : b` (IEEE 1800-2023 §11.4.11; `CE.cond`) whose condition is a comparison of
two `int`s (`s< s<= s> s>=`, the loader's spelling of a comparison of signed operands, §11.4.4, and `==`, `!=`, §11.4.5;
`CE.cmp`) or an `int`. At a symbolic parameter the instantiation cannot decide the condition, so the parameter stage
evaluates both arms and the environment holds `if c then a else b` (`liftIte`, `eq_ok_ite_of_cases`), which `omega` reads
as a case split, as it reads the summary's value.

* `lp_cond.sv`: `S = ((N > 2) ? 1 : 0) + ((N >= 5) ? 1 : 0)` (a 2-state `int`) as a declared dimension, a generate bound
  and an index, `W = (N < 4) ? 4 : N` as a width and a bound, and `Q` (unused) with `==`, `!=` and a nested `?:`;
* `neg/lp_cmp_num.sv`: `C = (N > 2) + 1`, a comparison used as a number (refused, `CE.cmpOk`).

The envelopes were generated by
`python3.12 extractors/sv/extract.py --top <module> Examples/system-verilog/lp_cond/<file>.sv -o <file>.sv.json`.
-/

namespace Examples.«system-verilog».lp_cond.gen

open LeanModels.Sv LeanModels.Sv.CombView

load_design_sv2 lp_cond from "Examples/system-verilog/lp_cond/lp_cond.sv.json"
load_design_sv2 lp_cmp_num from "Examples/system-verilog/lp_cond/neg/lp_cmp_num.sv.json"

#guard (lp_cond.pdesign.summary.toOption.map fun s => s.lps.map (·.2)) == some
  [.add (.cond (.cmp .gt (.ref "N") (.lit 2)) (.lit 1) (.lit 0)) (.cond (.cmp .ge (.ref "N") (.lit 5)) (.lit 1) (.lit 0)),
   .cond (.cmp .lt (.ref "N") (.lit 4)) (.lit 4) (.ref "N"),
   .cond (.cmp .eq (.ref "N") (.lit 3)) (.lit 0) (.cond (.cmp .ne (.ref "N") (.lit 4)) (.lit 1) (.lit 2))]
#guard (lp_cmp_num.pdesign.summary.toOption.isNone)

-- The summary's values are the instantiation's (`hag` by `rfl` at a concrete point) and the values Icarus Verilog 13.0
-- prints for the same definitions (`iverilog -g2012`): `S, W, Q` = 0, 4, 1 at `N = 1`; 0, 4, 1 at `N = 2`; 1, 4, 0 at
-- `N = 3`; 1, 4, 2 at `N = 4`; 2, 5, 1 at `N = 5`; 2, 9, 1 at `N = 9`.
#guard [1, 2, 3, 4, 5, 9].map (fun n =>
    (lp_cond.pdesign.paramEnv2 [n]).toOption.map fun e => ["S", "W", "Q"].map e.intVal?) ==
  [some [some 0, some 4, some 1], some [some 0, some 4, some 1], some [some 1, some 4, some 0],
   some [some 1, some 4, some 2], some [some 2, some 5, some 1], some [some 2, some 9, some 1]]
#guard (lp_cond.pdesign.summary.toOption.map fun s => [1, 2, 3, 4, 5, 9].map fun n =>
    ["S", "W", "Q"].map (s.val [n])) ==
  some [[0, 4, 1], [0, 4, 1], [1, 4, 0], [1, 4, 2], [2, 5, 1], [2, 9, 1]]

end Examples.«system-verilog».lp_cond.gen
