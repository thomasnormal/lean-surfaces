import LeanModels.Sv.Ingest2
import LeanModels.Sv.Gen2
import LeanModels.Sv.CombView

/-!
# `lp_pow`: localparams defined by `**`, as `sv_comb` test subjects

A localparam of the fragment may use `**` of two `int`s (IEEE 1800-2023 §11.4.3; `CE.pow`): `a ** b` is `a ^ b` for the
non-negative exponent `b`, an `int`. The instantiation refuses a negative exponent (`evalIntExactRec`: "negative
exponent"; IEEE Table 11-4 gives 0 for a base other than 0 and ±1, and Icarus Verilog 13.0 prints 0: the instantiation is
the stricter, so the tactics never read such a value), and wraps the power to 32 bits like every `int` result.

* `lp_pow.sv`: `L = $clog2(N + 1)`, `P = 2 ** L` (the least power of two above `N`) as a declared width and in a
  generate bound, `T = 3 ** 2` (a 2-state `int`, squashed by the elaborator: `Squash2`) as a width and a bound;
* `neg/lp_pow_neg.sv`: `Z = 2 ** (N - 5)`, a negative exponent where `N < 5`;
* `neg/lp_pow_wide.sv`: `Z = 2 ** N`, no `int` from `N = 31` on.

The envelopes were generated by
`python3.12 extractors/sv/extract.py --top <module> Examples/system-verilog/lp_pow/<file>.sv -o <file>.sv.json`.
-/

namespace Examples.«system-verilog».lp_pow.gen

open LeanModels.Sv LeanModels.Sv.CombView

load_design_sv2 lp_pow from "Examples/system-verilog/lp_pow/lp_pow.sv.json"
load_design_sv2 lp_pow_neg from "Examples/system-verilog/lp_pow/neg/lp_pow_neg.sv.json"
load_design_sv2 lp_pow_wide from "Examples/system-verilog/lp_pow/neg/lp_pow_wide.sv.json"

-- The summary reads the definitions, `**` included (the squashed `int` `T` through its operand).
#guard (lp_pow.pdesign.summary.toOption.map fun s => s.lps.map (·.2)) == some
  [.clog2 (.add (.ref "N") (.lit 1)), .pow (.lit 2) (.ref "L"), .pow (.lit 3) (.lit 2)]

-- The summary's values are the instantiation's 32-bit `int` values (`hag` by `rfl` at a concrete point), and the
-- values Icarus Verilog 13.0 prints for the same definitions (`iverilog -g2012`, a testbench of the three localparams
-- at each `N`): `L, P, T` = 1, 2, 9 at `N = 1`; 3, 8, 9 at `N = 7`; 4, 16, 9 at `N = 8`; 7, 128, 9 at `N = 100`;
-- 28, 268435456, 9 at `N = 268435455`.
#guard [1, 7, 8, 100, 268435455].map (fun n =>
    (lp_pow.pdesign.paramEnv2 [n]).toOption.map fun e => ["L", "P", "T"].map e.intVal?) ==
  [some [some 1, some 2, some 9], some [some 3, some 8, some 9], some [some 4, some 16, some 9],
   some [some 7, some 128, some 9], some [some 28, some 268435456, some 9]]
#guard (lp_pow.pdesign.summary.toOption.map fun s => [1, 7, 8, 100, 268435455].map fun n =>
    ["L", "P", "T"].map (s.val [n])) ==
  some [[1, 2, 9], [3, 8, 9], [4, 16, 9], [7, 128, 9], [28, 268435456, 9]]

-- `Z = 2 ** (N - 5)`: the instantiation refuses the negative exponent at `N = 4` and reads 2 at `N = 6`; `Z = 2 ** N` is
-- the wrapped `int`, `-2147483648` at `N = 31` and 0 at `N = 32` (Icarus: 0 at `N = 32`).
#guard (lp_pow_neg.pdesign.paramEnv2 [4]).toOption.isNone
#guard ((lp_pow_neg.pdesign.paramEnv2 [6]).toOption.map fun e => e.intVal? "Z") == some (some 2)
#guard ((lp_pow_wide.pdesign.paramEnv2 [31]).toOption.map fun e => e.intVal? "Z") == some (some (-2147483648))
#guard ((lp_pow_wide.pdesign.paramEnv2 [32]).toOption.map fun e => e.intVal? "Z") == some (some 0)

end Examples.«system-verilog».lp_pow.gen
