import LeanModels.Sv.Ingest2
import LeanModels.Sv.Gen2
import LeanModels.Sv.CombView

/-!
# `lp_shift`: localparams defined by shifts, as `sv_comb` test subjects

A localparam of the fragment is a constant expression of the parameters (`CombView.lean`, "Local parameters"); it may
use the shifts of an `int` (IEEE 1800-2023 §11.4.10): `<<` and `<<<` (the same operation), `>>` (the logical shift of
the 32-bit pattern) and `>>>` (the arithmetic shift of the signed value). The summary reads each shift on the 32-bit
patterns of its operands, the amount as an unsigned 32-bit number (`CE.eval`), so its value is the IEEE result for every
operand value, and the agreement with the instantiation (`hag`) holds exactly where the two are the same number.

* `lp_shl.sv`: a ripple adder with an unused `S = N << 1` (formerly the negative fixture `lp_add/neg/lp_shift.sv`);
* `lp_shifts.sv`: `M = N << 1`, `H = M >> 1`, `Q = (N <<< 2) >>> 2` as a declared width and select bounds, and an unused
  `P = (1 << (K - 1)) - 1` by a parameter amount;
* `localparam_shift.sv`: the clean-room repro, `BIAS = (1 << (E - 1)) - 1` used as a value in `y = x + BIAS`;
* `neg/`: a shift by an amount that is negative at some parameter value, `1 << 40` (0 in an `int`, out of the 32-bit
  range in the summary), `>>` of an operand that is negative at some parameter value (`comb_errors.lean`).

The envelopes were generated by
`python3.12 extractors/sv/extract.py --top <module> Examples/system-verilog/lp_shift/<file>.sv -o <file>.sv.json`.
-/

namespace Examples.«system-verilog».lp_shift.gen

open LeanModels.Sv LeanModels.Sv.CombView

load_design_sv2 lp_shift from "Examples/system-verilog/lp_shift/lp_shl.sv.json"
load_design_sv2 lp_shifts from "Examples/system-verilog/lp_shift/lp_shifts.sv.json"
load_design_sv2 localparam_shift from "Examples/system-verilog/lp_shift/localparam_shift.sv.json"

-- The summary reads every localparam definition, the shifts included.
#guard lp_shift.pdesign.summary.toOption.isSome
#guard lp_shifts.pdesign.summary.toOption.isSome
#guard (lp_shifts.pdesign.summary.toOption.map fun s => s.lps.map (·.2)) == some
  [.shl (.ref "N") (.lit 1), .shr (.ref "M") (.lit 1), .ashr (.shl (.ref "N") (.lit 2)) (.lit 2),
   .sub (.shl (.lit 1) (.sub (.ref "K") (.lit 1))) (.lit 1)]

-- The summary's values agree with the instantiation's 32-bit `int` values at concrete points (`hag` by `rfl`):
-- `M = 16`, `H = 8`, `Q = 8`, `P = 3` at `N = 8`, `K = 3`; `P = 0` at `K = 1`.
#guard (lp_shifts.pdesign.summary.toOption.map fun s => ["M", "H", "Q", "P"].map (s.val [8, 3])) ==
  some [16, 8, 8, 3]
#guard (lp_shifts.pdesign.summary.toOption.map fun s => s.val [5, 1] "P") == some 0
#guard ((lp_shifts.pdesign.paramEnv2 [8, 3]).toOption.map fun e => ["M", "H", "Q", "P"].map e.intVal?) ==
  some [some 16, some 8, some 8, some 3]

-- Runs, each the value local Icarus Verilog 12.0 prints for the same inputs (`iverilog -g2012`): `lp_shifts` at `N = 8`,
-- `a = 0xA5`, `b = 0x3C`: `y = 1010010100111100`, `z = 10011001`; at `N = 5`, `a = 10110`, `b = 01101`: `y =
-- 1011001101`, `z = 11011`.
#guard (match run2 (lp_shifts.sem 8 3) σ_src 1000 [[("a", .ofNat 8 0xA5), ("b", .ofNat 8 0x3C)]] with
  | .ok [st] =>
      (SvState.lookup st "y").map LVec.toBinString == some "1010010100111100" &&
      (SvState.lookup st "z").map LVec.toBinString == some "10011001"
  | _ => false)
#guard (match run2 (lp_shifts.sem 5 1) σ_src 1000 [[("a", .ofNat 5 22), ("b", .ofNat 5 13)]] with
  | .ok [st] =>
      (SvState.lookup st "y").map LVec.toBinString == some "1011001101" &&
      (SvState.lookup st "z").map LVec.toBinString == some "11011"
  | _ => false)
-- `localparam_shift`: `BIAS = 127` at `E = 8` (`x = 200`: `y = 01000111`), `15` at `E = 5` (`x = 3`: `y = 10010`),
-- `2147483647` at `E = 32` (`1 << 31` is `-2^31`, and `-2^31 - 1` wraps; `x = 5`: `y = 1` followed by 29 zeros, `100`).
#guard (match run2 (localparam_shift.sem 8) σ_src 1000 [[("x", .ofNat 8 200)]] with
  | .ok [st] => (SvState.lookup st "y").map LVec.toBinString == some "01000111"
  | _ => false)
#guard (match run2 (localparam_shift.sem 5) σ_src 1000 [[("x", .ofNat 5 3)]] with
  | .ok [st] => (SvState.lookup st "y").map LVec.toBinString == some "10010"
  | _ => false)
#guard (match run2 (localparam_shift.sem 32) σ_src 1000 [[("x", .ofNat 32 5)]] with
  | .ok [st] => (SvState.lookup st "y").map LVec.toBinString == some "10000000000000000000000000000100"
  | _ => false)
#guard ((localparam_shift.pdesign.paramEnv2 [32]).toOption.map fun e => e.intVal? "BIAS") == some (some 2147483647)

end Examples.«system-verilog».lp_shift.gen
