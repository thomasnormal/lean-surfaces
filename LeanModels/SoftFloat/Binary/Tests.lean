/-- `(decode f x).value?` is the fraction `n / d` (compared by cross-multiplication). -/
def valueIs (f : Format) (x : BitVec f.k) (n : Int) (d : Nat) : Bool :=
  match (decode f x).value? with
  | some (a, b) => a * d == n * b
  | none => false

