      },
      "id": "char_bit_8",
      "required": true,
      "why": "pos_seal memcpy's the 120-byte board into uint64_t w[15]; 120 bytes is 15 words only if a byte is 8 bits (sunfish.c L199-201)"
    },
    {
      "agreed": true,
      "depended_on": true,
      "expr": "sizeof(int) == 4",
      "holds": {
        "arm64-apple-darwin": true,
        "x86_64-unknown-linux-gnu": true
      },
      "id": "int_32",
      "required": true,
      "why": "PACK_VM packs (uint32_t)(int) into the high half of a uint64_t and VM_VAL unpacks it; the move-ordering key is exact only at 32 bits (L649-652)"
    },
    {
      "agreed": true,
      "depended_on": true,
      "expr": "sizeof(long) == 8",
      "holds": {
        "arm64-apple-darwin": true,
        "x86_64-unknown-linux-gnu": true
      },
      "id": "long_64",
      "required": true,
      "why": "TABLE_SIZE and the node counters are long (L83, L496-497)"
    },
    {
      "agreed": true,
      "depended_on": false,
      "expr": "sizeof(long long) == 8",
      "holds": {
        "arm64-apple-darwin": true,
        "x86_64-unknown-linux-gnu": true
      },
      "id": "long_long_64",
      "required": true,
      "why": "reached only through uint64_t, which <stdint.h> fixes exactly"
    },
    {
      "agreed": true,
      "depended_on": false,
      "expr": "sizeof(void *) == 8",
      "holds": {
        "arm64-apple-darwin": true,
        "x86_64-unknown-linux-gnu": true
      },
      "id": "pointer_64",
      "required": true,
      "why": "no integer<->pointer cast in the corpus (0 sites), so no observable depends on the width; the model needs it for sizeof only"
    },
    {
      "agreed": true,
      "depended_on": false,
      "expr": "sizeof(short) == 2",
      "holds": {
        "arm64-apple-darwin": true,
        "x86_64-unknown-linux-gnu": true
      },
      "id": "short_16",
      "required": true,
      "why": "unused by the corpus"
    },
    {
      "agreed": true,
      "depended_on": true,
      "expr": "INT_MIN == -INT_MAX - 1",
      "holds": {
        "arm64-apple-darwin": true,
        "x86_64-unknown-linux-gnu": true
      },
      "id": "twos_complement",
      "required": true,
      "why": "C23 6.2.6.2 mandates it; the signed-overflow UB boundary the tier arms is stated against it"
    },
    {
      "agreed": true,
      "depended_on": true,
      "expr": "(char)-1 < 0",
      "holds": {
        "arm64-apple-darwin": true,
        "x86_64-unknown-linux-gnu": true
      },
      "id": "char_signed",
      "required": true,
      "why": "the board is char b[120] and CLS[(int)p->b[j]] indexes a 128-entry table by it (L346); every board byte is ASCII < 128, so no VALUE changes \u2014 but the in-bounds ARGUMENT is a function of the sign"
    },
    {
      "agreed": true,
      "depended_on": true,
      "expr": "(unsigned)-1 == UINT_MAX",
      "holds": {
        "arm64-apple-darwin": true,
        "x86_64-unknown-linux-gnu": true
      },
      "id": "unsigned_wraps",
      "required": true,
      "why": "mix64's x *= 0xff51afd7ed558ccdULL is deliberate defined wraparound (L192-193); standard-guaranteed, recorded because the tier must NOT refuse it while refusing signed overflow"
    },
    {
      "agreed": true,
      "depended_on": true,
      "expr": "(uint32_t)(-1) == 0xFFFFFFFFu",
      "holds": {
        "arm64-apple-darwin": true,
        "x86_64-unknown-linux-gnu": true
      },
      "id": "int_to_uint32_modulo",
      "required": true,
      "why": "PACK_VM biases a signed val by (uint32_t)(val) ^ 0x80000000u (L649)"
    },
    {
      "agreed": true,
      "depended_on": true,
      "expr": "(int)0x80000000u == INT_MIN",
      "holds": {
        "arm64-apple-darwin": true,
        "x86_64-unknown-linux-gnu": true
      },
      "id": "uint_to_int_wraps",
      "required": true,
      "why": "VM_VAL converts the unbiased key back with (int)(... ^ 0x80000000u) (L652).  C23 6.3.1.3 MANDATES the two's-complement result; under C17 this was implementation-defined, so the -std=c23 pin is load-bearing for the move ordering, not a formality"
    },
    {
      "agreed": true,
      "depended_on": false,
      "expr": "__BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__",
      "holds": {
        "arm64-apple-darwin": true,
        "x86_64-unknown-linux-gnu": true
      },
      "id": "little_endian",
      "required": true,
      "why": "pos_seal hashes the board THROUGH uint64_t words, so h is endian-dependent \u2014 but h is never observable: pos_eq uses it only as a fast reject in front of a full memcmp (L209-217) and the bucket layout it induces is unobservable by the file's own argument (L403-405).  Measured, deliberately NOT depended on"
    },
    {
      "agreed": true,
      "depended_on": false,
      "expr": "(-1 >> 1) == -1",
      "holds": {
        "arm64-apple-darwin": true,
        "x86_64-unknown-linux-gnu": true
      },
      "id": "arithmetic_right_shift",
      "required": true,
      "why": "the corpus has ZERO signed right shifts \u2014 all 6 >> sites are on uint64_t (L192-194, L652-653).  Measured so the claim stays checkable"
    }
