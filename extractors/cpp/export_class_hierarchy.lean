import LeanModels.Cpp.ClassSubobjects

open Lean LeanModels.Cpp

/- Export the admitted IR, never a handwritten replacement for a source body.
The capture/source hashes and capture environment belong in the external receipt.
The complete probe is validated before the selected occurrence is lowered. -/

private def refuse (stage reason : String) : IO UInt32 := do
  IO.eprintln s!"export_class_hierarchy: {stage}: {reason}"
  return 2

def main (arguments : List String) : IO UInt32 := do
  let [input, pathText, namespaceName] := arguments
    | IO.eprintln "usage: lake env lean --run extractors/cpp/export_class_hierarchy.lean PROBE PATH NAMESPACE"; return 1
  let some path := (pathText.splitOn ",").mapM String.toNat?
    | return ← refuse "path" "expected comma-separated nonnegative indices"
  unless (namespaceName.splitOn ".").all cppIdentifier do
    return ← refuse "namespace" "expected ASCII identifier components"
  -- Escape even keyword components, so every accepted name prints valid Lean.
  let printedNamespace := String.intercalate "."
    ((namespaceName.splitOn ".").map fun part => s!"«{part}»")
  try
    let before ← (System.FilePath.mk input).metadata
    unless before.type == .file do return ← refuse "input-io" "probe must be a regular file"
    if before.byteSize > 128 * 1024 * 1024 then
      return ← refuse "input-byte-bound" "probe exceeds 128 MiB export bound"
    let bytes ← IO.FS.readBinFile input
    let after ← (System.FilePath.mk input).metadata
    unless before.byteSize == after.byteSize && before.modified == after.modified &&
        after.byteSize.toNat == bytes.size do
      return ← refuse "input-read" "probe changed while reading"
    let some contents := String.fromUTF8? bytes
      | return ← refuse "probe-format" "invalid UTF-8"
    let probe ← match parseDeclarationProbeString contents with
      | .ok probe => pure probe
      | .error reason => return ← refuse "probe-format" reason
    let _types ← match parseValidatedTypeEvidence probe with
      | .ok rows => pure rows
      | .error reason => return ← refuse "type-evidence" reason
    let _binaries ← match parseValidatedBinaryExpressionEvidence probe with
      | .ok rows => pure rows
      | .error reason => return ← refuse "binary-evidence" reason
    let expressionTypes ← match parseValidatedExpressionTypeEvidence probe with
      | .ok rows => pure rows
      | .error reason => return ← refuse "expression-types" reason
    let some _expressionTypes := expressionTypes
      | return ← refuse "expression-types" "class hierarchy exporter requires the supplement"
    let hierarchy ← match ClassHierarchyAdmission.admit probe path with
      | .ok getter => pure getter
      | .error reason => return ← refuse "admission" reason
    IO.println "-- Generated by extractors/cpp/export_class_hierarchy.lean. DO NOT EDIT."
    IO.println "-- Complete canonical probe validated before admission; LP64 profile."
    IO.println "import LeanModels.Cpp.ClassSubobjects"
    IO.println s!"\nnamespace {printedNamespace}"
    IO.println "\nopen LeanModels.Cpp"
    IO.println s!"\ndef hierarchy : ClassHierarchy :=\n{reprStr hierarchy}"
    IO.println s!"\nend {printedNamespace}"
    return 0
  catch error => refuse "input-io" error.toString
